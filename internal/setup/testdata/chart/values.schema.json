{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "puid": {
          "type": "integer"
        },
        "pgid": {
          "type": "integer"
        },
        "tz": {
          "type": "string"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/definitions/claim"
        },
        "config": {
          "$ref": "#/definitions/claim"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "parentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            }
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "greeting": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "beta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "token": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "instances": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "suffix",
                  "category",
                  "enabled"
                ],
                "properties": {
                  "suffix": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "gamma": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        }
      }
    }
  }
}
