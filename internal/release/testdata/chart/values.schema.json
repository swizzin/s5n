{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apps"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "puid": { "type": "integer" },
        "pgid": { "type": "integer" },
        "tz": { "type": "string" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": { "$ref": "#/$defs/volume" },
        "config": { "$ref": "#/$defs/volume" }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "parentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" },
            "sectionName": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "wiring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": { "type": "integer" }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled"],
        "properties": {
          "enabled": { "type": "boolean" },
          "port": { "type": "integer" }
        }
      }
    }
  },
  "$defs": {
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": { "type": "string" },
        "hostPath": { "type": "string" },
        "size": { "type": "string" }
      }
    }
  }
}
